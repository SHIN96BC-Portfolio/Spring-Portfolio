{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductViewed",
  "description": "상품 상세 조회 시 발행(또는 BFF 수집). recommendation 구독.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "traceId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ProductViewed" },
    "eventVersion": { "type": "integer", "default": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["userId", "productId"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "productId": { "type": "integer" },
        "variantId": { "type": "integer" },
        "referrerType": {
          "type": "string",
          "enum": ["ORGANIC", "RECOMMENDATION", "SEARCH"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
